# 发布配置示例
# 复制为 publish.toml 后按需修改；含服务器信息的版本不入库

[publish]
# 发布方式：local（复制到本地目录）或 sftp（上传到远程服务器）
method = "local"

# 本地发布目录
dest_path = ""

# 远程发布根目录（SFTP 时使用，以 / 结尾）
remote_root = ""

# SSH 配置（SFTP 时使用）。字段直接传给 ssh2 的 connect，
# 支持 host / port / username / password / privateKey 等，例如：
#   ssh_config = { host = "example.com", port = 22, username = "user", privateKey = "C:/keys/id_rsa" }
ssh_config = {}
