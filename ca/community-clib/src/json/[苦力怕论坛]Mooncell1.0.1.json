        },
        "location": {
            "type": "enum",
            "name": "槽位类型(hasitem)\n  slot.armor(马铠)\n  slot.armor.chest(胸甲)\n  slot.armor.feet(靴子)\n  slot.armor.legs(护腿)\n  slot.chest(箱子)\n  slot.enderchest(末影箱)\n  slot.equippable(鞍或马铠)\n   0:\n    仅马、驴、骡;\n    物品名必须为鞍或空气;\n   1:\n    仅马和羊驼;\n    物品名必须属于马铠一类;",
            "list": "entity_slot",
            "hasInverted": true
        },
        "slot": {
            "type": "entity_slot",
            "name": "指定槽位编号(hasitem)\n  0-9 (hotbar-快捷栏)\n  0-27 (inventory-背包)"
