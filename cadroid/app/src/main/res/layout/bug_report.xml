<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/bug_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_report_title"
            android:textColor="#FF000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bug_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FF000000"
            android:textSize="14sp" />

        <Button
            android:id="@+id/bug_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/bug_report_copy"
            android:textColor="#FF000000" />

        <Button
            android:id="@+id/bug_ignore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/bug_report_ignore"
            android:textColor="#FF000000" />

        <Button
            android:id="@+id/bug_kill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/bug_report_kill"
            android:textColor="#FF000000"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
